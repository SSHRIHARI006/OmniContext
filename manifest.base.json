{
  "manifest_version": 3,
  "name": "OmniContext — LLM Context & Bloat Monitor",
  "version": "1.2.0",
  "description": "Real-time context window usage, token density, and context health monitor across ChatGPT, Claude, Gemini, DeepSeek, Kimi, Qwen.",
  "author": "OmniContext Team",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.chatgpt.com/*",
    "*://*.openai.com/*",
    "*://*.claude.ai/*",
    "*://*.gemini.google.com/*",
    "*://*.deepseek.com/*",
    "*://*.moonshot.cn/*",
    "*://*.kimi.com/*",
    "*://*.aliyun.com/*",
    "*://*.qwenlm.ai/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "OmniContext Monitor",
    "default_icon": "src/assets/icons/icon.svg"
  },
  "icons": {
    "16": "src/assets/icons/icon.svg",
    "48": "src/assets/icons/icon.svg",
    "128": "src/assets/icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chatgpt.com/*",
        "*://*.openai.com/*",
        "*://*.claude.ai/*",
        "*://*.gemini.google.com/*",
        "*://*.deepseek.com/*",
        "*://*.moonshot.cn/*",
        "*://*.kimi.com/*",
        "*://*.aliyun.com/*",
        "*://*.qwenlm.ai/*"
      ],
      "js": [
        "src/content/omniNamespace.js",
        "src/core/domUtils.js",
        "src/core/browserApi.js",
        "src/core/modelRegistry.js",
        "src/core/tokenEngine.js",
        "src/core/metricsCalculator.js",
        "src/core/metricsView.js",
        "src/core/migrationPrompt.js",
        "src/content/adapters/baseAdapter.js",
        "src/content/adapters/chatgptAdapter.js",
        "src/content/adapters/claudeAdapter.js",
        "src/content/adapters/geminiAdapter.js",
        "src/content/adapters/deepseekAdapter.js",
        "src/content/adapters/kimiAdapter.js",
        "src/content/adapters/qwenAdapter.js",
        "src/content/adapters/genericAdapter.js",
        "src/content/ui/shadowContainer.js",
        "src/content/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/interceptor.js",
        "src/content/ui/floatingWidget.css",
        "src/assets/icons/icon.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
